    <!-- 記事単体表示 -->
    <article class="article" id="articleView" style="display:none;">
      <div id="articleContent"></div>
      <div class="article-foot">
        <a href="news.html" class="btn btn--ghost">← お知らせ一覧へ戻る</a>
        <a href="index.html" class="btn btn--dark" data-home="">トップページへ戻る</a>
      </div>
    </article>

  </div>
</main>

<!-- ==================== FOOTER ==================== -->
<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="en">cosmetic mikiya</div>
        <div class="jp">コ ス メ テ ィ ッ ク &nbsp; ミ キ ヤ</div>
        <div class="brand-line"></div>
      </div>
      <div class="footer-cols">
        <div>
          <h5>SITE MAP</h5>
          <ul>
            <li><a href="index.html" data-home="">トップページ</a></li>
            <li><a href="index.html#concept" data-home="#concept">コンセプト</a></li>
            <li><a href="index.html#brands"  data-home="#brands">取り扱いブランド</a></li>
            <li><a href="index.html#shop"    data-home="#shop">店舗案内</a></li>
            <li><a href="news.html">お知らせ</a></li>
          </ul>
        </div>
        <div>
          <h5>SHOP</h5>
          <ul>
            <li>須磨パティオ内</li>
            <li>神戸市須磨区中落合2丁目2-1</li>
            <li>10:00〜20:00</li>
            <li><a href="tel:0787918055">078-791-8055</a></li>
          </ul>
        </div>
        <div>
          <h5>SOCIAL</h5>
          <ul>
            <li><a href="https://www.instagram.com/" target="_blank" rel="noopener">Instagram</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span id="footerYear"></span>
      <span>須磨パティオのカウンセリング化粧品専門店</span>
    </div>
  </div>
</footer>

<script>
(function(){
  "use strict";

  /* ================================================================
     設定
  ================================================================ */
  var MICROCMS_DOMAIN  = 'mikiyapathio';
  var MICROCMS_API_KEY = 'MQfCc3YdhLQBgNGroOwTdHDuqTZEnnMZROpf';
  var PAGE_SIZE = 20;   /* 一覧の1回あたりの取得件数 */

  /* トップページのファイル名。
     GitHub Pages等の公開環境では index.html、
     手元のPCでファイルを直接開いたとき（file://）は cosmetic_mikiya.html を見に行く。
     公開時のトップページのファイル名が index.html 以外の場合はここを書き換える。 */
  var HOME_FILE = (location.protocol === 'file:') ? 'cosmetic_mikiya.html' : 'index.html';

  /* data-home が付いたリンクのhrefを、上のHOME_FILEに合わせて書き換える */
  document.querySelectorAll('[data-home]').forEach(function(a){
    a.setAttribute('href', HOME_FILE + (a.getAttribute('data-home') || ''));
  });

  /* ================================================================
     共通ユーティリティ
  ================================================================ */
  function escapeHtml(str){
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function fmtDate(str){
    var d = new Date(str);
    return isNaN(d.getTime()) ? String(str || '')
      : d.getFullYear()+'.'+String(d.getMonth()+1).padStart(2,'0')+'.'+String(d.getDate()).padStart(2,'0');
  }

  /* 本文・説明文にあたる項目名の候補。
     microCMS側の項目名が変わっても拾えるよう、順番に探して最初の非空を使う。 */
  var BODY_KEYS = ['body','content','detail','description','text','note'];

  function pickBodyRaw(item){
    for(var i=0; i<BODY_KEYS.length; i++){
      var v = item[BODY_KEYS[i]];
      if(typeof v !== 'string' && typeof v !== 'number') continue;
      var s = String(v).trim();
      if(s) return s;
    }
    return '';
  }

  /* 一覧用：HTMLタグを外した素のテキスト（抜粋表示に使う） */
  function toPlainText(raw){
    return String(raw || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  }

  /* 記事本文の描画用。
     microCMSのリッチエディタはHTML文字列で返るのでそのまま挿入し、
     プレーンテキストの項目なら改行を<br>に変換したうえでエスケープする。 */
  function toBodyHtml(raw){
    if(!raw) return '';
    var looksLikeHtml = /<\/?[a-z][\s\S]*>/i.test(raw);
    if(looksLikeHtml) return raw;
    return raw.split(/\n{2,}/).map(function(block){
      return '<p>'+escapeHtml(block).replace(/\n/g,'<br>')+'</p>';
    }).join('');
  }

  function getTag(item){
    return item.tag || (item.category && item.category.name) || 'お知らせ';
  }

  function apiUrl(path){
    return 'https://'+MICROCMS_DOMAIN+'.microcms.io/api/v1/news'+path
      + (path.indexOf('?') >= 0 ? '&' : '?') + '_=' + Date.now();
  }

  /* microCMS取得の共通処理。
     ※ ヘッダーは X-MICROCMS-API-KEY 以外を絶対に追加しないこと。
        Cache-Control などを足すと CORS プリフライトでブラウザがブロックする。 */
  function fetchApi(path){
    return fetch(apiUrl(path), {
      headers:{ 'X-MICROCMS-API-KEY': MICROCMS_API_KEY },
      mode:'cors',
    }).then(function(res){
      if(!res.ok) throw new Error('HTTP '+res.status);
      return res.json();
    });
  }

  /* ================================================================
     一覧表示
  ================================================================ */
  var listView   = document.getElementById('listView');
  var listEl     = document.getElementById('newsList');
  var listState  = document.getElementById('listState');
  var listNotice = document.getElementById('listNotice');
  var moreRow    = document.getElementById('moreRow');
  var moreBtn    = document.getElementById('moreBtn');
  var offset     = 0;

  function entryHtml(item){
    var title = item.title || '（タイトルなし）';
    var date  = item.date || item.publishedAt || '';
    var tag   = getTag(item);
    var img   = item.image && item.image.url ? item.image.url : '';
    var desc  = toPlainText(pickBodyRaw(item));

    var thumb = img
      ? '<div class="entry-thumb"><img src="'+escapeHtml(img)+'?w=240&h=240&fit=crop" alt="" loading="lazy"></div>'
      : '<div class="entry-thumb-empty" aria-hidden="true">mikiya</div>';

    /* idが無い記事（サンプル表示など）は詳細ページを開けないのでリンクを付けない */
    var link = item.id
      ? '<a class="entry-link" href="news.html?id='+encodeURIComponent(item.id)+'" aria-label="'+escapeHtml(title)+'（詳細を読む）"></a>'
      : '';

    return '<li class="entry">'
      + link
      + thumb
      + '<div class="entry-body">'
        + '<div class="entry-meta">'
          + '<time>'+escapeHtml(fmtDate(date))+'</time>'
          + '<span class="tag">'+escapeHtml(tag)+'</span>'
        + '</div>'
        + '<h2>'+escapeHtml(title)+'</h2>'
        + (desc ? '<p class="entry-desc">'+escapeHtml(desc)+'</p>' : '')
      + '</div>'
      + '<span class="entry-arrow" aria-hidden="true">→</span>'
      + '</li>';
  }

  function appendEntries(items){
    listEl.insertAdjacentHTML('beforeend', items.map(entryHtml).join(''));
  }

  /* 取得に失敗したときのサンプル表示（ページを空にしないため） */
  var FALLBACK_NEWS = [
    { title:'クレ・ド・ポー ボーテ 新作コレクション入荷のご案内',    date:'2026-06-20', tag:'新商品入荷' },
    { title:'夏のスキンケアカウンセリングフェアを開催します（〜7/31）', date:'2026-06-05', tag:'お知らせ'   },
    { title:'須磨パティオ 設備点検にともなう臨時休業のお知らせ',       date:'2026-05-22', tag:'店休日'     },
    { title:'リサージ 新作スキンケアライン入荷のご案内',              date:'2026-05-10', tag:'新商品入荷' },
  ];

  function loadList(){
    moreBtn.disabled = true;
    moreBtn.textContent = '読み込み中…';

    fetchApi('/?limit='+PAGE_SIZE+'&offset='+offset+'&orders=-date')
      .then(function(data){
        listState.style.display = 'none';
        listNotice.style.display = 'none';

        var items = data.contents || [];
        if(offset === 0 && !items.length){
          listState.style.display = 'block';
          listState.innerHTML = '現在、お知らせはありません。<span class="sub">新しい情報が入り次第、こちらに掲載します。</span>';
          moreRow.style.display = 'none';
          return;
        }

        appendEntries(items);
        offset += items.length;

        var total = typeof data.totalCount === 'number' ? data.totalCount : offset;
        if(offset < total){
          moreRow.style.display = 'flex';
          moreBtn.disabled = false;
          moreBtn.textContent = 'さらに読み込む（残り'+(total - offset)+'件）';
        } else {
          moreRow.style.display = 'none';
        }
      })
      .catch(function(err){
        console.error('microCMS news fetch failed:', err);
        moreRow.style.display = 'none';
        if(offset === 0){
          /* 初回取得に失敗 — サンプルを出しつつ、状況を明示する */
          appendEntries(FALLBACK_NEWS);
          listState.style.display = 'none';
          listNotice.style.display = 'block';
          listNotice.textContent = '※ 最新のお知らせを読み込めませんでした。表示中の項目はサンプルです。通信環境をご確認のうえ、ページを再読み込みしてください。';
        } else {
          listNotice.style.display = 'block';
          listNotice.textContent = '※ 続きのお知らせを読み込めませんでした。ページを再読み込みしてください。';
        }
      });
  }

  moreBtn.addEventListener('click', loadList);

  /* ================================================================
     記事単体表示
  ================================================================ */
  var articleView    = document.getElementById('articleView');
  var articleContent = document.getElementById('articleContent');
  var pageTitle      = document.getElementById('pageTitle');
  var pageLead       = document.getElementById('pageLead');
  var crumbs         = document.getElementById('crumbs');

  function showArticle(id){
    listView.style.display = 'none';
    articleView.style.display = 'block';

    /* パンくずを「トップ › お知らせ › 記事」に差し替え */
    crumbs.innerHTML =
      '<a href="'+escapeHtml(HOME_FILE)+'">トップ</a>'
      + '<span class="sep">›</span>'
      + '<a href="news.html">お知らせ</a>'
      + '<span class="sep">›</span>'
      + '<span class="current">記事</span>';

    pageTitle.textContent = 'お知らせ';
    pageLead.style.display = 'none';

    articleContent.innerHTML = '<div class="state">記事を読み込んでいます…</div>';

    fetchApi('/'+encodeURIComponent(id))
      .then(function(item){
        var title = item.title || '（タイトルなし）';
        var date  = item.date || item.publishedAt || '';
        var tag   = getTag(item);
        var img   = item.image && item.image.url ? item.image.url : '';
        var body  = toBodyHtml(pickBodyRaw(item));

        document.title = title + '｜お知らせ｜cosmetic mikiya';
        pageTitle.textContent = title;

        articleContent.innerHTML =
          '<div class="article-head">'
            + '<div class="article-meta">'
              + '<time>'+escapeHtml(fmtDate(date))+'</time>'
              + '<span class="tag">'+escapeHtml(tag)+'</span>'
            + '</div>'
            + '<h1 class="article-title">'+escapeHtml(title)+'</h1>'
          + '</div>'
          + (img ? '<figure class="article-figure"><img src="'+escapeHtml(img)+'?w=1200" alt="'+escapeHtml(title)+'"></figure>' : '')
          /* 本文が未登録の記事は、代わりの文言を出さずに何も表示しない */
          + (body ? '<div class="article-body">'+body+'</div>' : '');
      })
      .catch(function(err){
        console.error('microCMS article fetch failed:', err);
        articleContent.innerHTML =
          '<div class="state">'
          + 'この記事を表示できませんでした。'
          + '<span class="sub">記事が削除されたか、通信環境に問題がある可能性があります。<br>下のボタンからお知らせ一覧をご確認ください。</span>'
          + '</div>';
      });
  }

  /* ================================================================
     ルーティング — ?id=xxxx があれば記事単体、無ければ一覧
  ================================================================ */
  var params = new URLSearchParams(location.search);
  var articleId = params.get('id');

  if(articleId){
    showArticle(articleId);
  } else {
    loadList();
  }

  /* ---- ヘッダー スクロール ---- */
  var header = document.getElementById('siteHeader');
  function onScroll(){ header.classList.toggle('is-scrolled', window.scrollY > 20); }
  document.addEventListener('scroll', onScroll, { passive:true });
  onScroll();

  /* ---- フッター年号 ---- */
  var y = document.getElementById('footerYear');
  if(y){ y.textContent = '© '+new Date().getFullYear()+' cosmetic mikiya'; }

})();
</script>

</body>
</html>
